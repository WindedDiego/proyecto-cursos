     Archivo: src/views/examenes/resolver.ejs (Seguro contra variables nulas)
     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Realizar Examen - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="max-width: 800px;">
        
        <header class="header-seccion">
            <span class="badge rounded-pill text-uppercase mb-2" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.75rem;">Evaluación en curso</span>
            <h1 class="text-verde-primario">Examen: <%= examen.tipo %></h1>
            <p class="lead mb-0">Responde a todas las preguntas con atención antes de enviar.</p>
        </header>

        <main>
            <div class="mb-4">
                <a href="/cursos/<%= cursoId %>/examenes" class="btn btn-secundario">← Cancelar y Volver</a>
            </div>

            <% const listaPreguntas = examen.Preguntas || examen.Pregunta || []; %>
            
            <% if (listaPreguntas.length === 0) { %>
                <div class="empty-state py-5">
                    <div class="icon">📝</div>
                    <h4 class="text-verde-primario fw-bold mb-2">Sin preguntas</h4>
                    <p class="text-muted mb-0">Este examen no tiene preguntas disponibles todavía.</p>
                </div>
            <% } else { %>
                <form action="/cursos/<%= cursoId %>/examenes/<%= examen.id %>/resolver" method="POST">
                    <% listaPreguntas.forEach((pregunta, index) => { %>
                        <div class="tarjeta-contenido mb-4 p-4">
                            <h5 class="fw-bold mb-3" style="color: var(--texto-principal)">
                                <%= index + 1 %>. <%= pregunta.enunciado %>
                            </h5>
                            
                            <% if (pregunta.tipo === 'desarrollo') { %>
                                <textarea name="pregunta_desarrollo_<%= pregunta.id %>" class="form-control" rows="4" placeholder="Escribe aquí tu respuesta detallada..." required></textarea>
                            <% } else { %>
                                <% const listaRespuestas = pregunta.Respuestas || pregunta.Respuesta || []; %>
                                <div class="d-flex flex-column gap-2 mt-3">
                                    <% listaRespuestas.forEach(resp => { %>
                                        <div class="form-check p-3 bg-light rounded border" style="border-color: var(--borde-suave) !important; cursor: pointer;">
                                            <input class="form-check-input ms-1" type="radio" name="pregunta_<%= pregunta.id %>" value="<%= resp.id %>" id="resp_<%= resp.id %>" required>
                                            <label class="form-check-label ms-2 w-100" for="resp_<%= resp.id %>" style="cursor: pointer;">
                                                <%= resp.texto %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                    
                    <div class="mb-5">
                        <button type="submit" class="btn btn-primario w-100 py-3 fs-5 shadow-sm">Enviar Examen Definitivo</button>
                    </div>
                </form>
            <% } %>
        </main>
    </div>
</body>
</html>