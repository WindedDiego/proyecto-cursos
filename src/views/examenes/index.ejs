<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Exámenes del Curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Exámenes del curso: <%= curso.nombre %></h1>
    
    <div class="mb-4">
        <!-- Botón exclusivo para Profesor / Admin -->
        <div id="btn-crear-examen" class="d-inline-block d-none me-2">
            <a href="/cursos/<%= curso.id %>/examenes/crear" class="btn btn-primary">Crear nuevo examen</a>
        </div>
    </div>

    <% if (examenes.length === 0) { %>
        <p class="text-muted">No hay exámenes disponibles en este curso.</p>
    <% } else { %>
        <div class="list-group">
            <% examenes.forEach(examen => { %>
                <div class="list-group-item d-flex justify-content-between align-items-center p-3 mb-2 shadow-sm">
                    <div>
                        <h5 class="mb-1"><%= examen.tipo %></h5>
                        
                        <!-- VISUALIZACIÓN DE NOTAS DIRECTAMENTE PARA EL ALUMNO -->
                        <div class="info-notas-alumno d-none mt-2">
                            <% 
                                const resTest = (typeof misResultadosTest !== 'undefined') ? misResultadosTest[examen.id] : null;
                                const notasDes = (typeof misNotasDesarrollo !== 'undefined') ? misNotasDesarrollo[examen.id] : null;
                            %>

                            <% if (resTest) { %>
                                <span class="badge bg-primary me-2">Test: <%= resTest.aciertos %> / <%= resTest.total %> aciertos</span>
                            <% } %>

                            <% if (notasDes && notasDes.length > 0) { %>
                                <% notasDes.forEach((nd, idx) => { %>
                                    <span class="badge bg-<%= nd.calificacion !== null ? 'success' : 'warning text-dark' %> me-1">
                                        Desarrollo [P<%= idx+1 %>]: <%= nd.calificacion !== null ? nd.calificacion + ' pts' : 'Pendiente' %>
                                    </span>
                                <% }) %>
                            <% } %>

                            <% if (!resTest && (!notasDes || notasDes.length === 0)) { %>
                                <span class="text-muted small">Sin realizar / sin calificar</span>
                            <% } %>
                        </div>
                    </div>

                    <div>
                        <!-- Botón para Profesor / Admin -->
                        <div class="acciones-profesor d-none d-inline-block">
                            <a href="/cursos/<%= curso.id %>/examenes/<%= examen.id %>" class="btn btn-warning btn-sm">⚙️ Modificar / Añadir preguntas</a>
                            <a href="/cursos/<%= curso.id %>/examenes/<%= examen.id %>/corregir" class="btn btn-dark btn-sm">📝 Corregir desarrollo</a>
                        </div>
                        <!-- Botón para Alumno -->
                        <div class="acciones-alumno d-none d-inline-block">
                            <a href="/cursos/<%= curso.id %>/examenes/<%= examen.id %>" class="btn btn-success btn-sm">✏️ Ver / Hacer el examen</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <div class="mt-4">
        <a href="/cursos/<%= curso.id %>" class="btn btn-secondary">← Volver al curso</a>
    </div>

    <script>
        function obtenerRolDeToken() {
            const token = localStorage.getItem('token');
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload).rol;
            } catch (e) {
                return null;
            }
        }

        const rol = obtenerRolDeToken();
        if (rol === 'profesor' || rol === 'administrador') {
            const btnCrear = document.getElementById('btn-crear-examen');
            if (btnCrear) btnCrear.classList.remove('d-none');
            document.querySelectorAll('.acciones-profesor').forEach(el => el.classList.remove('d-none'));
        } else if (rol === 'alumno') {
            document.querySelectorAll('.acciones-alumno').forEach(el => el.classList.remove('d-none'));
            document.querySelectorAll('.info-notas-alumno').forEach(el => el.classList.remove('d-none'));
        }
    </script>
</body>
</html>