<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Modificar Pregunta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 600px;">
    <h2>Modificar Pregunta</h2>
    <form action="/cursos/<%= cursoId %>/examenes/<%= examenId %>/preguntas/<%= pregunta.id %>/editar" method="POST" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Enunciado de la pregunta</label>
            <textarea name="enunciado" class="form-control" rows="3" required><%= pregunta.enunciado %></textarea>
        </div>

        <% const respuestas = pregunta.Respuestas || pregunta.Respuesta || []; %>
        <div class="mb-3">
            <label class="form-label">Respuesta 1</label>
            <input type="text" name="r1" class="form-control" value="<%= respuestas[0] ? respuestas[0].texto : '' %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Respuesta 2</label>
            <input type="text" name="r2" class="form-control" value="<%= respuestas[1] ? respuestas[1].texto : '' %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Respuesta 3</label>
            <input type="text" name="r3" class="form-control" value="<%= respuestas[2] ? respuestas[2].texto : '' %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Respuesta 4</label>
            <input type="text" name="r4" class="form-control" value="<%= respuestas[3] ? respuestas[3].texto : '' %>" required>
        </div>

        <div class="mb-3">
            <label class="form-label">¿Cuál es la respuesta correcta?</label>
            <select name="correcta" class="form-select" required>
                <% respuestas.forEach((resp, idx) => { %>
                    <option value="<%= idx + 1 %>" <%= resp.correcta ? 'selected' : '' %>>Respuesta <%= idx + 1 %></option>
                <% }) %>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Actualizar Pregunta</button>
        <a href="/cursos/<%= cursoId %>/examenes/<%= examenId %>" class="btn btn-secondary">Cancelar</a>
    </form>
</body>
</html>