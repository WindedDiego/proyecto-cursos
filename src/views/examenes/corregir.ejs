<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Corregir Desarrollo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
    <div class="container mt-4">
        <header class="header-seccion">
            <h1>Corrección de Exámenes de Desarrollo</h1>
            <div class="barra-botones mt-3">
                <a href="/cursos/<%= cursoId %>/examenes/<%= examenId %>" class="btn btn-secundario">← Volver al examen</a>
            </div>
        </header>

        <% if (entregas.length === 0) { %>
            <div class="tarjeta-contenido">
                <p class="text-muted mb-0">No hay respuestas de desarrollo enviadas por los alumnos para este examen.</p>
            </div>
        <% } else { %>
            <div class="row g-4">
                <% entregas.forEach(entrega => { %>
                    <div class="col-12">
                        <div class="tarjeta-contenido mb-0 border-start border-4" style="border-color: <%= entrega.calificacion !== null ? 'var(--verde-secundario)' : '#ffc107' %> !important;">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                <span class="fw-bold fs-5 text-verde-primario"><%= entrega.alumno ? entrega.alumno.nombre : 'Desconocido' %></span>
                                <% if (entrega.calificacion !== null && entrega.calificacion !== undefined) { %>
                                    <span class="badge bg-success fs-6">Nota: <%= entrega.calificacion %></span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark fs-6">Pendiente</span>
                                <% } %>
                            </div>
                            <p class="mb-2 fw-bold text-muted">Pregunta: <%= entrega.pregunta ? entrega.pregunta.enunciado : '' %></p>
                            <div class="bg-light p-3 rounded mb-4 border text-muted" style="white-space: pre-wrap;"><%= entrega.respuesta_texto %></div>

                            <form action="/cursos/<%= cursoId %>/examenes/<%= examenId %>/corregir/<%= entrega.id %>" method="POST" class="row g-3 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label fw-bold small">Calificación</label>
                                    <input type="number" step="0.1" name="calificacion" class="form-control" value="<%= entrega.calificacion !== null ? entrega.calificacion : '' %>" required>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Feedback (Opcional)</label>
                                    <input type="text" name="feedback" class="form-control" value="<%= entrega.feedback || '' %>">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primario w-100">Guardar Nota</button>
                                </div>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>