<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Corregir Exámenes de Desarrollo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Corrección de Exámenes de Desarrollo</h1>
    <a href="/cursos/<%= cursoId %>/examenes/<%= examenId %>" class="btn btn-secondary mb-3">← Volver al detalle del examen</a>

    <% if (entregas.length === 0) { %>
        <div class="alert alert-info">No hay respuestas de desarrollo enviadas por los alumnos para este examen.</div>
    <% } else { %>
        <div class="list-group">
            <% entregas.forEach(entrega => { %>
                <div class="list-group-item mb-3 shadow-sm p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="mb-1"><strong>Alumno:</strong> <%= entrega.alumno ? entrega.alumno.nombre : 'Desconocido' %> (<%= entrega.alumno ? entrega.alumno.email : '' %>)</p>
                        
                        <!-- AQUÍ SE VE AL PROFESOR SI YA ESTÁ GUARDADA Y QUÉ NOTA TIENE -->
                        <% if (entrega.calificacion !== null && entrega.calificacion !== undefined) { %>
                            <span class="badge bg-success">Nota guardada: <%= entrega.calificacion %></span>
                        <% } else { %>
                            <span class="badge bg-warning text-dark">Pendiente de calificar</span>
                        <% } %>

                    </div>
                    <p class="mt-2"><strong>Pregunta:</strong> <%= entrega.pregunta ? entrega.pregunta.enunciado : '' %></p>
                    <div class="bg-light p-3 rounded mb-3 border">
                        <strong>Respuesta del alumno:</strong>
                        <p class="mb-0 mt-1" style="white-space: pre-wrap;"><%= entrega.respuesta_texto %></p>
                    </div>

                    <form action="/cursos/<%= cursoId %>/examenes/<%= examenId %>/corregir/<%= entrega.id %>" method="POST" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Calificación (Nota)</label>
                            <input type="number" step="0.1" name="calificacion" class="form-control" value="<%= entrega.calificacion !== null && entrega.calificacion !== undefined ? entrega.calificacion : '' %>" placeholder="Ej: 8.5" required>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Feedback / Comentarios</label>
                            <input type="text" name="feedback" class="form-control" value="<%= entrega.feedback || '' %>" placeholder="Comentarios opcionales para el alumno...">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Guardar Nota</button>
                        </div>
                    </form>
                </div>
            <% }) %>
        </div>
    <% } %>
</body>
</html>