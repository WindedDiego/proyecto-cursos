<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Detalle del Examen</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Examen: <%= examen.tipo %></h1>
    <a href="/cursos/<%= cursoId %>/examenes" class="btn btn-secondary mb-3">← Volver a exámenes</a>

    <div class="mb-4">
        <!-- Botón de añadir pregunta exclusivo para profesor -->
        <div id="btn-crear-pregunta" class="d-inline-block d-none me-2">
            <a href="/cursos/<%= cursoId %>/examenes/<%= examen.id %>/preguntas" class="btn btn-primary">➕ Añadir nueva pregunta</a>
        </div>
        <!-- Alumno hace el examen, observador solo audita -->
        <div id="btn-alumno-resolver" class="d-inline-block d-none">
            <a href="/cursos/<%= cursoId %>/examenes/<%= examen.id %>/resolver" class="btn btn-success">✏️ Hacer este examen</a>
        </div>
    </div>

    <h3>Preguntas del Examen</h3>
    
    <% const listaPreguntas = examen.Preguntas || examen.Pregunta || []; %>

    <% if (listaPreguntas.length === 0) { %>
        <p class="text-muted">Este examen aún no tiene preguntas añadidas.</p>
    <% } else { %>
        <div class="list-group">
            <% listaPreguntas.forEach((pregunta, index) => { %>
                <div class="list-group-item mb-3 shadow-sm p-3">
                    <h5>Pregunta <%= index + 1 %>: <%= pregunta.enunciado %></h5>
                    <ul class="mb-3">
                        <% const listaRespuestas = pregunta.Respuestas || pregunta.Respuesta || []; %>
                        <% listaRespuestas.forEach(resp => { %>
                            <li class="<%= puedeVerCorrectas && resp.correcta ? 'text-success fw-bold' : '' %>">
                                <%= resp.texto %> <%= puedeVerCorrectas && resp.correcta ? '(Correcta)' : '' %>
                            </li>
                        <% }) %>
                    </ul>
                    <!-- Botón de modificar pregunta exclusivo para profesor -->
                    <div class="btn-modificar-pregunta d-none">
                        <a href="/cursos/<%= cursoId %>/examenes/<%= examen.id %>/preguntas/<%= pregunta.id %>/editar" class="btn btn-sm btn-outline-dark">Modificar pregunta</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <script>
        function obtenerRolDeToken() {
            const token = localStorage.getItem('token');
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload).rol;
            } catch (e) {
                return null;
            }
        }

        const rol = obtenerRolDeToken();
        if (rol === 'profesor' || rol === 'administrador') {
            const btnCrear = document.getElementById('btn-crear-pregunta');
            if (btnCrear) btnCrear.classList.remove('d-none');
            document.querySelectorAll('.btn-modificar-pregunta').forEach(el => el.classList.remove('d-none'));
        } else if (rol === 'alumno') {
            const btnResolver = document.getElementById('btn-alumno-resolver');
            if (btnResolver) btnResolver.classList.remove('d-none');
        }
    </script>
</body>
</html>