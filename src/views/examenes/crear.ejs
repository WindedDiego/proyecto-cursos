<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear examen</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow">
          <div class="card-body">
            <h3 class="mb-1">Crear examen</h3>
            <p class="text-muted mb-4">Curso: <strong><%= curso.titulo %></strong></p>

            <!-- El action ahora apunta directamente a la ruta del curso actual -->
            <form action="/cursos/<%= curso.id %>/examenes/crear" method="POST">
              
              <div class="mb-3">
                <label class="form-label">Tipo de examen</label>
                <input type="text" name="tipo" class="form-control" placeholder="Ej: Test Parcial, Examen Final, Práctica" required>
              </div>

              <button type="submit" class="btn btn-primary w-100">Guardar examen</button>
            </form>

            <div class="mt-3 text-center">
              <a href="/cursos/<%= curso.id %>/examenes" class="btn btn-link">← Volver a exámenes del curso</a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>