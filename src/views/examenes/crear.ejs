<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Crear examen</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
    <div class="container py-5" style="max-width: 600px;">
        <header class="header-seccion mb-4">
            <h1 class="mb-1">Crear Examen</h1>
            <p class="text-muted mb-0"><%= curso.titulo %></p>
        </header>
        <main class="tarjeta-contenido">
            <form action="/cursos/<%= curso.id %>/examenes/crear" method="POST">
                <div class="mb-4">
                    <label class="form-label fw-bold">Título / Tipo de examen</label>
                    <input type="text" name="tipo" class="form-control bg-light" placeholder="Ej: Test Parcial, Examen Final..." required>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primario w-100">Guardar examen</button>
                    <a href="/cursos/<%= curso.id %>/examenes" class="btn btn-secundario w-100 text-center">Volver</a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>