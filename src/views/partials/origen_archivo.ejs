<%# Selector "URL o archivo". Parámetros: etiqueta (texto), obligatorio (bool), maxMB (número) %>
<% const _obligatorio = !!locals.obligatorio; %>
<div class="mb-4" data-origen>
    <label class="form-label fw-bold"><%= locals.etiqueta || 'Origen' %></label>

    <% if (!_obligatorio) { %>
        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="tipo_origen" id="origenNinguno" value="ninguno" checked>
            <label class="form-check-label" for="origenNinguno">Sin adjunto</label>
        </div>
    <% } %>
    <div class="form-check mb-2">
        <input class="form-check-input" type="radio" name="tipo_origen" id="origenUrl" value="url" <%= _obligatorio ? 'checked' : '' %>>
        <label class="form-check-label" for="origenUrl">Proporcionar una URL</label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="radio" name="tipo_origen" id="origenArchivo" value="archivo">
        <label class="form-check-label" for="origenArchivo">Subir un archivo</label>
    </div>

    <div id="bloqueUrl" style="display: none;">
        <input type="url" id="inputUrl" name="url" class="form-control" maxlength="255" placeholder="https://ejemplo.com">
    </div>

    <div id="bloqueArchivo" style="display: none;">
        <input type="file" id="inputArchivo" name="archivo" class="form-control" accept="<%= (locals.subida ? subida.extensiones : []).join(',') %>">
        <div class="form-text">Tamaño máximo: <%= locals.maxMB || 10 %> MB.</div>
    </div>
</div>

<script>
    (function () {
        const obligatorio = <%= _obligatorio ? 'true' : 'false' %>;
        const radios = document.querySelectorAll('input[name="tipo_origen"]');
        const bloqueUrl = document.getElementById('bloqueUrl');
        const bloqueArchivo = document.getElementById('bloqueArchivo');
        const inputUrl = document.getElementById('inputUrl');
        const inputArchivo = document.getElementById('inputArchivo');

        function actualizar() {
            const tipo = document.querySelector('input[name="tipo_origen"]:checked').value;
            bloqueUrl.style.display = tipo === 'url' ? 'block' : 'none';
            bloqueArchivo.style.display = tipo === 'archivo' ? 'block' : 'none';
            inputUrl.required = tipo === 'url';
            inputArchivo.required = tipo === 'archivo';
            // Los campos ocultos no se envían con datos de otra opción
            if (tipo !== 'url') inputUrl.value = '';
            if (tipo !== 'archivo') inputArchivo.value = '';
        }

        radios.forEach(r => r.addEventListener('change', actualizar));
        actualizar();
    })();
</script>
