<!DOCTYPE html>
<html lang="es">
<head>
 <meta charset="UTF-8">
 <title>Panel de Profesor - Plataforma Escolar</title>
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 <link rel="stylesheet" href="/css/style.css">
</head>
<body>
 <div class="container py-5">
   
  <!-- CABECERA -->
  <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-4">
   <div>
    <span class="badge rounded-pill text-uppercase mb-2" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.75rem;">Profesor / Docente</span>
    <h1 class="text-verde-primario">Panel de Profesor</h1>
    <p class="lead mb-0">Docente: <strong><%= usuario.nombre %></strong></p>
   </div>
   <div>
    <a href="/cursos" class="btn btn-outline-secondary shadow-sm">Volver al inicio</a>
   </div>
  </header>

  <!-- OPCIONES DEL PANEL -->
  <main class="row g-4">
   
   <!-- Ver Cursos -->
   <div class="col-md-6 col-lg-3">
    <div class="tarjeta-contenido h-100 p-4 d-flex flex-column justify-content-between text-center">
     <div>
      <div class="fs-1 mb-3">📚</div>
      <h3 class="h5 text-verde-primario fw-bold">Gestionar Cursos</h3>
      <p class="text-muted small">Administra los cursos, asignaturas y contenidos docentes.</p>
     </div>
     <a href="/cursos" class="btn btn-primario mt-3 w-100">Ver Cursos</a>
    </div>
   </div>

   <!-- Ver Exámenes -->
   <div class="col-md-6 col-lg-3">
    <div class="tarjeta-contenido h-100 p-4 d-flex flex-column justify-content-between text-center">
     <div>
      <div class="fs-1 mb-3">📝</div>
      <h3 class="h5 text-verde-primario fw-bold">Exámenes y Pruebas</h3>
      <p class="text-muted small">Crea, edita y corrige exámenes de tus asignaturas.</p>
     </div>
     <% if (cursos && cursos.length > 0) { %>
      <a href="/cursos/<%= cursos[0].id %>/examenes" class="btn btn-primario mt-3 w-100">Ver Exámenes</a>
     <% } else { %>
      <button class="btn btn-secondary mt-3 w-100" disabled>Sin exámenes</button>
     <% } %>
    </div>
   </div>

   <!-- Ir a los Foros -->
   <div class="col-md-6 col-lg-3">
    <div class="tarjeta-contenido h-100 p-4 d-flex flex-column justify-content-between text-center">
     <div>
      <div class="fs-1 mb-3">💬</div>
      <h3 class="h5 text-verde-primario fw-bold">Foros Académicos</h3>
      <p class="text-muted small">Modera y participa en los debates de los cursos.</p>
     </div>
     <% if (cursos && cursos.length > 0) { %>
      <a href="/cursos/<%= cursos[0].id %>/foros" class="btn btn-primario mt-3 w-100">Ir a Foros</a>
     <% } else { %>
      <button class="btn btn-secondary mt-3 w-100" disabled>Sin foros</button>
     <% } %>
    </div>
   </div>

   <!-- Modificar Datos -->
   <div class="col-md-6 col-lg-3">
    <div class="tarjeta-contenido h-100 p-4 d-flex flex-column justify-content-between text-center">
     <div>
      <div class="fs-1 mb-3">⚙️</div>
      <h3 class="h5 text-verde-primario fw-bold">Modificar Datos</h3>
      <p class="text-muted small">Edita tu información de perfil, credenciales y datos personales.</p>
     </div>
     <a href="/usuarios/perfil" class="btn btn-secundario mt-3 w-100">Editar Perfil</a>
    </div>
   </div>

  </main>
 </div>
</body>
</html>