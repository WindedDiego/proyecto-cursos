<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Profesor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Panel de Profesor 👨‍🏫</h1>
    <p>Bienvenido, <strong><%= usuario.nombre %></strong></p>
    <hr>
    <a href="/cursos" class="btn btn-primary mb-3">Gestionar Cursos</a>
    <a href="/examenes" class="btn btn-secondary mb-3">Gestionar Exámenes</a>
    
    <h3 class="mt-4">Actividad reciente de los alumnos</h3>
    <ul class="list-group">
        <% actividades.forEach(act => { %>
            <li class="list-group-item">
                <strong><%= act.usuario ? act.usuario.nombre : 'Anónimo' %></strong> accedió a <code><%= act.recurso %></code> el <%= act.hora_entrada %>
            </li>
        <% }) %>
    </ul>
    <br>
    <a href="/cursos" class="btn btn-dark">Volver al inicio</a>
</body>
</html>