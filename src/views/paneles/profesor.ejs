<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Profesor - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <span class="badge rounded-pill text-uppercase mb-2" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.75rem;">Profesor / Docente</span>
                <h1 class="text-verde-primario">Panel de Profesor</h1>
                <p class="lead mb-0">Docente: <strong><%= usuario.nombre %></strong></p>
            </div>
            <div>
                <a href="/cursos" class="btn btn-primario shadow-sm">Gestionar Cursos &rarr;</a>
            </div>
        </header>

        <main class="row g-4">
            <div class="col-lg-5">
                <div class="tarjeta-contenido h-100 p-4">
                    <h3 class="h4 text-verde-primario mb-4 pb-2 border-bottom">Acceso Rápido a Evaluaciones</h3>
                    <% if (cursos && cursos.length > 0) { %>
                        <div class="d-flex flex-column gap-3">
                            <% cursos.forEach(curso => { %>
                                <div class="p-3 rounded border bg-light d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark"><%= curso.titulo %></span>
                                    <a href="/cursos/<%= curso.id %>/examenes" class="btn btn-secundario btn-sm">Exámenes</a>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No tienes asignaturas asignadas actualmente.</p>
                    <% } %>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="tarjeta-contenido h-100 p-4">
                    <h3 class="h4 text-verde-primario mb-4 pb-2 border-bottom">Actividad de la Clase</h3>
                    <div class="table-responsive">
                        <table class="tabla-resultados w-100">
                            <thead>
                                <tr>
                                    <th>Alumno</th>
                                    <th>Recurso</th>
                                    <th class="text-end">Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (actividades && actividades.length > 0) { %>
                                    <% actividades.forEach(act => { %>
                                        <tr>
                                            <td class="fw-bold"><%= act.usuario ? act.usuario.nombre : 'Anónimo' %></td>
                                            <td><code><%= act.recurso %></code></td>
                                            <td class="text-end text-muted small"><%= new Date(act.hora_entrada).toLocaleString('es-ES') %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="3" class="text-center text-muted py-4">Sin actividad reciente registrada.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>