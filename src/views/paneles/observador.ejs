<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Observador (Informes)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Panel de Observador / Informes 🕵️</h1>
    <p class="text-muted">Modo de sólo lectura (Administración)</p>
    <hr>
    
    <h3>Fichas de Alumnos</h3>
    <ul class="list-group mb-4">
        <% alumnos.forEach(alumno => { %>
            <li class="list-group-item">ID: <%= alumno.id %> | Nombre: <strong><%= alumno.nombre %></strong> | Email: <%= alumno.email %></li>
        <% }) %>
    </ul>

    <h3>Registro completo de horas de actividad</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Recurso</th>
                <th>Entrada</th>
                <th>Salida</th>
            </tr>
        </thead>
        <tbody>
            <% todasLasActividades.forEach(act => { %>
                <tr>
                    <td><%= act.usuario ? act.usuario.nombre : 'Anónimo' %></td>
                    <td><%= act.recurso %></td>
                    <td><%= act.hora_entrada %></td>
                    <td><%= act.hora_salida || 'En curso' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>