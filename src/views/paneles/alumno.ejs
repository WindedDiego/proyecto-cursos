<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Alumno - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <span class="badge rounded-pill text-uppercase mb-2" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.75rem;">Estudiante</span>
                <h1 class="text-verde-primario">Panel de Alumno</h1>
                <p class="lead mb-0">Bienvenido/a, <strong><%= usuario.nombre %></strong></p>
            </div>
            <div>
                <a href="/cursos" class="btn btn-primario shadow-sm">Ver mis Cursos &rarr;</a>
            </div>
        </header>

        <main>
            <div class="tarjeta-contenido p-4">
                <h3 class="h4 text-verde-primario mb-4 pb-2 border-bottom">Historial de Actividad Reciente</h3>
                <div class="table-responsive">
                    <table class="tabla-resultados w-100">
                        <thead>
                            <tr>
                                <th>Recurso Accedido</th>
                                <th class="text-end">Fecha y Hora</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (misActividades && misActividades.length > 0) { %>
                                <% misActividades.forEach(act => { %>
                                    <tr>
                                        <td><code><%= act.recurso %></code></td>
                                        <td class="text-end text-muted small"><%= new Date(act.hora_entrada).toLocaleString('es-ES') %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="2" class="text-center text-muted py-4">Aún no hay registros de actividad recientes.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>