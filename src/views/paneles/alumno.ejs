<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Panel de Alumno</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Mi Panel de Alumno 👨‍🎓</h1>
    <p>Hola, <strong><%= usuario.nombre %></strong></p>
    <hr>
    <a href="/cursos" class="btn btn-primary mb-4">Ir a los Cursos</a>

    <h3>Mi propia actividad</h3>
    <ul class="list-group">
        <% misActividades.forEach(act => { %>
            <li class="list-group-item">
                Recurso visitado: <strong><%= act.recurso %></strong> | Entrada: <%= act.hora_entrada %>
            </li>
        <% }) %>
    </ul>
</body>
</html>