<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Resultados - <%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Resultados de Exámenes - <%= curso.titulo %></h1>
        <a href="/cursos/<%= curso.id %>" class="btn btn-secondary">← Volver al curso</a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Lista de Resultados
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Alumno</th>
                            <th>Curso</th>
                            <th>Tipo de Examen</th>
                            <th>Resultado (Aciertos/Total)</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (resultados && resultados.length > 0) { %>
                            <% resultados.forEach(res => { %>
                                <tr>
                                    <td><%= res.alumno ? res.alumno.nombre : 'N/A' %></td>
                                    <td><%= curso.titulo %></td>
                                    <td><%= res.examen ? res.examen.tipo : 'N/A' %></td>
                                    <td><%= res.aciertos %> / <%= res.total %></td>
                                    <td><%= new Date(res.fecha).toLocaleDateString() %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">No hay resultados registrados para este curso.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function obtenerRolDeToken() {
            const token = localStorage.getItem('token');
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload).rol;
            } catch (e) {
                return null;
            }
        }

        const rol = obtenerRolDeToken();
        if (rol === 'profesor' || rol === 'administrador') {
            // Añadir lógica si es necesario
        }
    </script>
</body>
</html>