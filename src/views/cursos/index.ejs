<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de cursos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
    <div class="container">
        <header class="header-seccion">
            <h1>Listado de cursos</h1>
            <div class="barra-botones">
                <!-- Contenedor dinámico donde aparecerá el botón del panel según el rol -->
                <div id="panel-container"></div>
                
                <% if (puedeGestionar) { %>
                    <a href="/cursos/crear" class="btn btn-primario">Crear nuevo curso</a>
                <% } %>
            </div>
        </header>

        <main class="tarjeta-contenido">
            <ul class="list-group">
              <% cursos.forEach(curso => { %>
                <li class="list-group-item p-4">
                  <a href="/cursos/<%= curso.id %>" class="text-decoration-none fw-bold" style="font-size: 1.1rem;">
                    <%= curso.titulo %>
                  </a>
                </li>
              <% }) %>
            </ul>
        </main>
    </div>
</body>
<script>
    // Función robusta para leer el rol desde el token JWT en localStorage
    function obtenerRolDeToken() {
        const token = localStorage.getItem('token');
        if (!token) return null;
        try {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload).rol;
        } catch (e) {
            console.error("Error al leer el token:", e);
            return null;
        }
    }

    // Al cargar la página, comprobamos el rol y pintamos los elementos correspondientes
    const rolUsuario = obtenerRolDeToken();
    const contenedor = document.getElementById('panel-container');

    if (rolUsuario === 'profesor') {
        contenedor.innerHTML = '<a href="/paneles/profesor" class="btn btn-primario">Ir a mi Panel de Profesor 👨‍🏫</a>';
    } else if (rolUsuario === 'administrador') {
        contenedor.innerHTML = '<a href="/paneles/administrador" class="btn btn-primario">Administrar plataforma</a>';
    } else if (rolUsuario === 'observador') {
        contenedor.innerHTML = '<a href="/paneles/observador" class="btn btn-secundario">Ir a Informes / Observador 🕵️</a>';
    } else if (rolUsuario === 'alumno') {
        contenedor.innerHTML = '<a href="/paneles/alumno" class="btn btn-secundario">Ver mi Panel de Alumno 👨‍🎓</a>';
    }
</script>
