<h1>Crear curso</h1>

<form action="/cursos/crear" method="POST">
  <label>Título</label>
  <input type="text" name="titulo" required>

  <label>Descripción</label>
  <textarea name="descripcion" required></textarea>

  <button type="submit">Crear curso</button>
</form>

<a href="/cursos">Volver</a>
