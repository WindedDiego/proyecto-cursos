<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Crear Nuevo Curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="max-width: 700px;">
        
        <header class="header-seccion">
            <h1 class="text-verde-primario">Crear Curso</h1>
            <p class="lead mb-0">Añade una nueva asignatura a la plataforma.</p>
        </header>

        <main class="tarjeta-contenido">
            <form action="/cursos/crear" method="POST">
                
                <div class="mb-4">
                    <label class="form-label">Título del curso</label>
                    <input type="text" name="titulo" class="form-control" placeholder="Ej: Desarrollo Web en Entorno Cliente" required>
                </div>

                <div class="mb-4">
                    <label class="form-label">Descripción</label>
                    <textarea name="descripcion" class="form-control" rows="4" placeholder="Breve resumen de lo que se estudiará en la asignatura..." required></textarea>
                </div>

                <% if (typeof usuario !== 'undefined' && usuario.rol === 'administrador') { %>
                    <div class="mb-4">
                        <label class="form-label">Profesor responsable</label>
                        <select name="profesor_id" class="form-select" required>
                            <option value="">Selecciona un profesor...</option>
                            <% if (typeof profesores !== 'undefined') { %>
                                <% profesores.forEach(profesor => { %>
                                    <option value="<%= profesor.id %>"><%= profesor.nombre %> (<%= profesor.email %>)</option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                <% } %>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primario w-100">Guardar Curso</button>
                    <a href="/cursos" class="btn btn-secundario w-100 text-center">Cancelar</a>
                </div>

            </form>
        </main>
        
    </div>
</body>
</html>