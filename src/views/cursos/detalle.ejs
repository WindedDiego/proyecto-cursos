     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= curso.titulo %> - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <!-- CABECERA DEL CURSO -->
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-4">
            <div>
                <h1 class="text-verde-primario"><%= curso.titulo %></h1>
                <p class="text-muted fs-5 mt-2 mb-0" style="max-width: 600px; line-height: 1.6;"><%= curso.descripcion %></p>
            </div>
            
            <!-- Acciones de Profesor -->
            <div id="seccion-acciones-profesor" class="d-none d-flex flex-wrap gap-2 flex-shrink-0 mt-3 mt-md-0">
                <a href="/cursos/<%= curso.id %>/editar" class="btn btn-secundario">
                    <span class="me-1">✏️</span> Editar curso
                </a>
                
                <form action="/cursos/<%= curso.id %>/eliminar" method="POST" onsubmit="return confirm('⚠️ ¿Estás seguro de eliminar este curso por completo?');" class="m-0">
                    <button type="submit" class="btn btn-outline-danger">
                        <span class="me-1">🗑️</span> Eliminar
                    </button>
                </form>
            </div>
        </header>

        <!-- MÓDULOS DEL CURSO EN GRID -->
        <main>
            <div class="row g-4 mb-5">
                
                <!-- Contenidos -->
                <div class="col-md-6 col-lg-3">
                    <div class="modulo-card">
                        <div class="modulo-icon-wrapper">📚</div>
                        <h3 class="h4 text-verde-primario mb-3">Contenidos</h3>
                        <p class="text-muted small mb-4 flex-grow-1">Material de estudio, PDFs, vídeos explicativos y enlaces.</p>
                        <a href="/cursos/<%= curso.id %>/contenidos" class="btn btn-primario w-100 rounded-pill">Ver Contenidos</a>
                    </div>
                </div>

                <!-- Tareas -->
                <div class="col-md-6 col-lg-3">
                    <div class="modulo-card">
                        <div class="modulo-icon-wrapper">📝</div>
                        <h3 class="h4 text-verde-primario mb-3">Tareas</h3>
                        <p class="text-muted small mb-4 flex-grow-1">Entregas de trabajos, proyectos del curso y correcciones.</p>
                        <a href="/cursos/<%= curso.id %>/tareas" class="btn btn-primario w-100 rounded-pill">Ver Tareas</a>
                    </div>
                </div>

                <!-- Exámenes -->
                <div class="col-md-6 col-lg-3">
                    <div class="modulo-card">
                        <div class="modulo-icon-wrapper">⭐</div>
                        <h3 class="h4 text-verde-primario mb-3">Exámenes</h3>
                        <p class="text-muted small mb-4 flex-grow-1">Pruebas de evaluación continua, test y desarrollo.</p>
                        <a href="/cursos/<%= curso.id %>/examenes" class="btn btn-primario w-100 rounded-pill">Ver Exámenes</a>
                    </div>
                </div>

                <!-- Foros -->
                <div class="col-md-6 col-lg-3">
                    <div class="modulo-card">
                        <div class="modulo-icon-wrapper">💬</div>
                        <h3 class="h4 text-verde-primario mb-3">Foros</h3>
                        <p class="text-muted small mb-4 flex-grow-1">Debates, resolución de dudas y comunicación con la clase.</p>
                        <a href="/cursos/<%= curso.id %>/foros" class="btn btn-primario w-100 rounded-pill">Ir a Foros</a>
                    </div>
                </div>

            </div>

            <!-- NAVEGACIÓN INFERIOR -->
            <div class="mt-4 pt-3 border-top" style="border-color: var(--borde-suave) !important;">
                <a href="/cursos" class="btn-volver">
                    <span class="fs-5">&larr;</span> Volver a mis cursos
                </a>
            </div>
        </main>
    </div>

    <!-- CONTROL DE ROL -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const token = localStorage.getItem('token');
            if (token) {
                try {
                    const payload = JSON.parse(decodeURIComponent(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
                    if (payload.rol === 'profesor' || payload.rol === 'administrador') {
                        document.getElementById('seccion-acciones-profesor').classList.remove('d-none');
                    }
                } catch (e) {
                    console.error("Error decodificando token", e);
                }
            }
        });
    </script>
</body>
</html>