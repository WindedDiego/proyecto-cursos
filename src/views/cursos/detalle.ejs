<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">

    <div class="card p-4 shadow-sm mb-4">
        <h1><%= curso.titulo %></h1>
        <p class="lead"><%= curso.descripcion %></p>
        
        <div class="d-flex gap-2">
            <a href="/cursos/<%= curso.id %>/editar" class="btn btn-warning btn-sm">Editar curso</a>
            <form action="/cursos/<%= curso.id %>/eliminar" method="POST" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de eliminar este curso?')">Eliminar</button>
            </form>
        </div>
    </div>

    <h3 class="mb-3">Secciones del curso</h3>
    <div class="list-group mb-4">
        <a href="/cursos/<%= curso.id %>/contenidos" class="list-group-item list-group-item-action">
            📂 Ver Contenidos del Curso (Vídeos, PDFs, Enlaces)
        </a>
        <a href="/cursos/<%= curso.id %>/tareas" class="list-group-item list-group-item-action">
            📝 Ver y Enviar Tareas de este Curso
        </a>
        <a href="/examenes" class="list-group-item list-group-item-action">
            📋 Ver Exámenes Disponibles
        </a>
    </div>

    <a href="/cursos" class="btn btn-secondary">← Volver al listado de cursos</a>

</body>
</html>