<!-- ==========================================================================
     Archivo: src/views/auth/login.ejs (Dos columnas con fondo educativo)
     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar sesión - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body, html { height: 100%; margin: 0; }
        .split-screen { display: flex; min-height: 100vh; width: 100%; }
        
        /* Columna Izquierda: Imagen educativa de fondo con capa semitransparente y texto blanco */
        .split-left {
            flex: 1;
            background: linear-gradient(rgba(27, 67, 50, 0.82), rgba(31, 41, 55, 0.88)), 
                        url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1920&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 4rem;
            color: #ffffff;
        }
        
        /* Columna Derecha: Fondo oscuro del proyecto */
        .split-right {
            flex: 1;
            background-color: var(--verde-oscuro);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        
        .auth-card-modern {
            background-color: var(--blanco);
            border-radius: 24px;
            padding: 3rem;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.25);
        }
        
        @media (max-width: 992px) {
            .split-screen { flex-direction: column; }
            .split-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="split-screen">
        
        <!-- COLUMNA IZQUIERDA (Imagen Escolar + Mensaje) -->
        <div class="split-left">
            <div class="mb-4">
                <span class="fs-1">📚</span>
            </div>
            <h1 class="display-5 fw-bold mb-3 text-white" style="font-family: 'Montserrat', sans-serif;">
                Tu aprendizaje,<br>tu futuro académico.
            </h1>
            <p class="lead text-white-50 mb-0" style="font-family: 'Lato', sans-serif;">
                Accede a tus asignaturas, entrega proyectos y comunícate con profesores en un entorno diseñado para el éxito.
            </p>
        </div>

        <!-- COLUMNA DERECHA (Formulario de Login) -->
        <div class="split-right">
            <div class="auth-card-modern">
                
                <div class="mb-4">
                    <h2 class="h3 fw-bold text-dark mb-1" style="font-family: 'Montserrat', sans-serif;">Bienvenido de nuevo</h2>
                    <p class="text-muted small">Introduce tus credenciales para acceder a tu cuenta.</p>
                </div>

                <form id="login-form" action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input type="email" name="email" class="form-control" placeholder="alumno@escuela.com" required>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="contrasena" class="form-control" placeholder="••••••••••••" required>
                    </div>

                    <button type="submit" class="btn btn-primario w-100 py-3 shadow-sm">Iniciar sesión</button>
                    
                    <div id="login-error" class="alert alert-danger mt-3 d-none py-2 small" role="alert"></div>
                </form>

                <div class="text-center mt-4 pt-3 border-top text-muted small">
                    ¿No tienes cuenta? <a href="/auth/register" class="fw-bold text-verde-primario text-decoration-none">Regístrate aquí</a>
                </div>

            </div>
        </div>

    </div>

    <script>
        const loginForm = document.getElementById('login-form');
        const loginError = document.getElementById('login-error');
        
        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            loginError.classList.add('d-none');
            
            try {
                const response = await fetch(loginForm.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(new FormData(loginForm))
                });
                
                const result = await response.json();
                if (!response.ok) throw new Error(result.mensaje || 'No se pudo iniciar sesión');
                
                localStorage.setItem('token', result.token);
                document.cookie = `token=${result.token}; path=/;`;
                
                const returnTo = new URLSearchParams(window.location.search).get('returnTo');
                const destination = returnTo ? new URL(returnTo, window.location.origin) : null;
                const safeDestination = destination && destination.origin === window.location.origin ? destination.pathname + destination.search + destination.hash : '/cursos';
                
                window.location.assign(safeDestination);
            } catch (error) {
                loginError.textContent = error.message;
                loginError.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>