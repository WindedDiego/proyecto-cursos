     Archivo: src/views/auth/register.ejs (Diseño Dos Columnas)
     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Registro - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body, html { height: 100%; margin: 0; }
        .split-screen { display: flex; min-height: 100vh; width: 100%; }
        .split-left {
            flex: 1;
            background-color: var(--beige-fondo);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 4rem;
            border-right: 1px solid var(--borde-suave);
        }
        .split-right {
            flex: 1;
            background-color: var(--verde-oscuro);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .auth-card-modern {
            background-color: var(--blanco);
            border-radius: 24px;
            padding: 2.5rem;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        @media (max-width: 992px) {
            .split-screen { flex-direction: column; }
            .split-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="split-screen">
        
        <!-- COLUMNA IZQUIERDA -->
        <div class="split-left">
            <div class="mb-4">
                <span class="fs-1">🎓</span>
            </div>
            <h1 class="display-5 fw-bold text-verde-primario mb-3" style="font-family: 'Montserrat', sans-serif;">
                Comienza tu etapa<br>formativa hoy.
            </h1>
            <p class="lead text-muted mb-0">
                Regístrate para unirte al aula virtual, gestionar tus entregas y mantener el contacto directo con tus profesores.
            </p>
        </div>

        <!-- COLUMNA DERECHA (Formulario de Registro) -->
        <div class="split-right">
            <div class="auth-card-modern">
                
                <div class="mb-3">
                    <h2 class="h3 fw-bold text-dark mb-1" style="font-family: 'Montserrat', sans-serif;">Crear cuenta</h2>
                    <p class="text-muted small">Rellena los datos para unirte a la plataforma.</p>
                </div>

                <form id="register-form" action="/auth/register" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Nombre completo</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Tu nombre" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input type="email" name="email" class="form-control" placeholder="alumno@escuela.com" required>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="contrasena" class="form-control" placeholder="••••••••••••" required>
                    </div>

                    <button type="submit" class="btn btn-primario w-100 py-3 shadow-sm">Completar registro</button>

                    <div id="register-error" class="alert alert-danger mt-3 d-none py-2 small" role="alert"></div>
                    
                    <div id="register-success" class="alert alert-success mt-3 d-none text-center py-3" role="alert">
                      ¡Cuenta creada con éxito! 🎉<br><br>
                      <a href="/auth/login" class="btn btn-primario btn-sm w-100">Ir a iniciar sesión</a>
                    </div>
                </form>

                <div id="login-link-container" class="text-center mt-3 pt-3 border-top text-muted small">
                    ¿Ya tienes una cuenta? <a href="/auth/login" class="fw-bold text-verde-primario text-decoration-none">Inicia sesión aquí</a>
                </div>

            </div>
        </div>

    </div>

    <script>
        const registerForm = document.getElementById('register-form');
        const registerError = document.getElementById('register-error');
        const registerSuccess = document.getElementById('register-success');
        
        registerForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            registerError.classList.add('d-none');
            registerSuccess.classList.add('d-none');
            
            try {
                const response = await fetch(registerForm.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(new FormData(registerForm))
                });
                
                const result = await response.json();
                if (!response.ok) throw new Error(result.mensaje || 'No se pudo completar el registro');
                
                registerForm.querySelector('button[type="submit"]').style.display = 'none';
                registerSuccess.classList.remove('d-none');
                document.getElementById('login-link-container').style.display = 'none';
            } catch (error) {
                registerError.textContent = error.message;
                registerError.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>