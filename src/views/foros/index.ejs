<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Foros de <%= curso.titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5">
    <a href="/cursos/<%= curso.id %>" class="btn btn-link px-0">Volver al curso</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h1 class="h3 mb-1">Foros del curso</h1>
        <p class="text-muted mb-0"><%= curso.titulo %></p>
      </div>
      <a href="/cursos/<%= curso.id %>/foros/crear" class="btn btn-primary">Crear foro</a>
    </div>

    <% if (foros.length) { %>
      <ul class="list-group">
        <% foros.forEach(foro => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <a href="/cursos/<%= curso.id %>/foros/<%= foro.id %>" class="text-decoration-none"><%= foro.titulo %></a>
            <span class="text-muted small">Foro #<%= foro.id %></span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-muted">Todavía no hay foros para este curso.</p>
    <% } %>
  </main>
</body>
</html>