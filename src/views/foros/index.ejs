<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foros de <%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
    <div class="container">
        <header class="header-seccion">
            <h1>Foros del curso</h1>
            <p class="text-muted mb-0"><%= curso.titulo %></p>
            <div class="barra-botones">
                <a href="/cursos/<%= curso.id %>/foros/crear" class="btn btn-primario">Crear foro</a>
                <a href="/cursos/<%= curso.id %>" class="btn btn-secundario">Volver al curso</a>
            </div>
        </header>

        <main class="tarjeta-contenido">
            <% if (foros.length) { %>
                <ul class="list-group">
                    <% foros.forEach(foro => { %>
                        <li class="list-group-item p-4 d-flex justify-content-between align-items-center gap-3">
                            <a href="/cursos/<%= curso.id %>/foros/<%= foro.id %>" class="text-decoration-none fw-bold">
                                <%= foro.titulo %>
                            </a>
                            <span class="text-muted small">Foro #<%= foro.id %></span>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="text-muted">Todavía no hay foros para este curso.</p>
            <% } %>
        </main>
    </div>
</body>
</html>