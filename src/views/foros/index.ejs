<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Foros - <%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <h1 class="text-verde-primario">Foros de Discusión</h1>
                <p class="lead mb-0"><%= curso.titulo %></p>
            </div>
            
            <div>
                <a href="/cursos/<%= curso.id %>/foros/crear" class="btn btn-primario shadow-sm">
                    <span class="fs-5 me-1">💬</span> Nuevo Debate
                </a>
            </div>
        </header>

        <main>
            <% if (foros && foros.length > 0) { %>
                <div class="d-flex flex-column">
                    <% foros.forEach(foro => { %>
                        <div class="tarjeta-lista flex-column flex-md-row">
                            <div class="icon-box">💬</div>
                            
                            <div class="flex-grow-1 text-center text-md-start">
                                <h4 class="fw-bold mb-1"><%= foro.titulo %></h4>
                                <span class="text-muted small">Hilo de debate</span>
                            </div>
                            
                            <div class="mt-3 mt-md-0 w-100 w-md-auto text-end">
                                <a href="/cursos/<%= curso.id %>/foros/<%= foro.id %>" class="btn btn-secundario w-100">
                                    Participar en el hilo &rarr;
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="icon">💭</div>
                    <h3 class="text-verde-primario fw-bold mb-2">Sala de foros vacía</h3>
                    <p class="text-muted">Aún no hay ningún hilo de debate creado. ¡Anímate a ser el primero!</p>
                </div>
            <% } %>

            <a href="/cursos/<%= curso.id %>" class="btn-volver">
                <span class="fs-5">&larr;</span> Volver al resumen del curso
            </a>
        </main>
    </div>
</body>
</html>