<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear foro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
  <div class="container py-5" style="max-width: 680px">
    <header class="header-seccion mb-4">
      <h1 class="mb-1">Crear foro</h1>
      <p class="text-muted mb-0"><%= curso.titulo %></p>
    </header>
    <main class="tarjeta-contenido">
      <form class="js-authenticated-form" action="/cursos/<%= curso.id %>/foros" method="POST">
        <div class="mb-4">
          <label for="titulo" class="form-label fw-bold">Título o tema del foro</label>
          <input id="titulo" name="titulo" class="form-control bg-light" maxlength="150" required>
        </div>
        <p class="text-danger" data-error role="alert" hidden></p>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primario w-100">Abrir foro</button>
          <a href="/cursos/<%= curso.id %>/foros" class="btn btn-secundario w-100 text-center">Cancelar</a>
        </div>
      </form>
    </main>
  </div>
  <script src="/js/authenticated-form.js" defer></script>
</body>
</html>