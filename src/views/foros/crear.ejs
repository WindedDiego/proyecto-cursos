<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Crear foro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 680px">
    <a href="/cursos/<%= curso.id %>/foros" class="btn btn-link px-0">Volver a los foros</a>
    <h1 class="h3 mb-1">Crear foro</h1>
    <p class="text-muted mb-4"><%= curso.titulo %></p>

    <form class="js-authenticated-form" action="/cursos/<%= curso.id %>/foros" method="POST">
      <div class="mb-3">
        <label for="titulo" class="form-label">Título</label>
        <input id="titulo" name="titulo" class="form-control" maxlength="150" required>
      </div>
      <p class="text-danger" data-error role="alert" hidden></p>
      <button type="submit" class="btn btn-primary">Crear foro</button>
    </form>
  </main>
  <script src="/js/authenticated-form.js" defer></script>
</body>
</html>