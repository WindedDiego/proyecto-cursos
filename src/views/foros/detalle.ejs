<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= foro.titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 820px">
    <a href="/cursos/<%= cursoId %>/foros" class="btn btn-link px-0">Volver a los foros</a>
    <h1 class="h3 mb-4"><%= foro.titulo %></h1>

    <section aria-label="Mensajes del foro" class="mb-5">
      <% if (foro.mensajes.length) { %>
        <ul class="list-group">
          <% foro.mensajes.forEach(mensaje => { %>
            <li class="list-group-item">
              <div class="d-flex justify-content-between gap-3 mb-2">
                <strong><%= mensaje.autor.nombre %></strong>
                <time class="text-muted small"><%= mensaje.fecha ? new Date(mensaje.fecha).toLocaleString('es-ES') : '' %></time>
              </div>
              <p class="mb-0" style="white-space: pre-wrap"><%= mensaje.contenido %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-muted">Todavía no hay mensajes en este foro.</p>
      <% } %>
    </section>

    <form class="js-authenticated-form" action="/cursos/<%= cursoId %>/foros/<%= foro.id %>/mensajes" method="POST">
      <div class="mb-3">
        <label for="contenido" class="form-label">Escribe un mensaje</label>
        <textarea id="contenido" name="contenido" class="form-control" rows="4" required></textarea>
      </div>
      <p class="text-danger" data-error role="alert" hidden></p>
      <button type="submit" class="btn btn-primary">Publicar mensaje</button>
    </form>
  </main>
  <script src="/js/authenticated-form.js" defer></script>
</body>
</html>