<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= foro.titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
  <div class="container mt-4" style="max-width: 820px">
    <header class="header-seccion">
      <h1 class="mb-1 text-verde-primario"><%= foro.titulo %></h1>
      <div class="barra-botones mt-3">
        <a href="/cursos/<%= cursoId %>/foros" class="btn btn-secundario">← Volver a Foros</a>
      </div>
    </header>

    <main>
      <section aria-label="Mensajes del foro" class="mb-4">
        <% if (foro.mensajes.length) { %>
          <div class="d-flex flex-column gap-3">
            <% foro.mensajes.forEach(mensaje => { %>
              <div class="tarjeta-contenido mb-0 p-4 border-start border-4" style="border-color: var(--verde-secundario) !important;">
                <div class="d-flex justify-content-between mb-2">
                  <strong style="color: var(--texto-principal)"><%= mensaje.autor.nombre %></strong>
                  <time class="text-muted small"><%= mensaje.fecha ? new Date(mensaje.fecha).toLocaleString('es-ES') : '' %></time>
                </div>
                <p class="mb-0 text-muted" style="white-space: pre-wrap"><%= mensaje.contenido %></p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="tarjeta-contenido text-center">
            <p class="text-muted mb-0">Sé el primero en iniciar la conversación.</p>
          </div>
        <% } %>
      </section>

      <div class="tarjeta-contenido bg-white">
        <form class="js-authenticated-form" action="/cursos/<%= cursoId %>/foros/<%= foro.id %>/mensajes" method="POST">
          <div class="mb-3">
            <label for="contenido" class="form-label fw-bold">Escribe tu respuesta</label>
            <textarea id="contenido" name="contenido" class="form-control bg-light" rows="3" required></textarea>
          </div>
          <p class="text-danger" data-error role="alert" hidden></p>
          <button type="submit" class="btn btn-primario w-100">Publicar mensaje</button>
        </form>
      </div>
    </main>
  </div>
  <script src="/js/authenticated-form.js" defer></script>
</body>
</html>