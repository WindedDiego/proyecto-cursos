<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Contenidos del curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Contenidos del curso: <%= curso.titulo %></h1>

    <ul class="list-group my-3">
        <% if (contenidos.length === 0) { %>
            <p class="text-muted">Aún no hay contenidos registrados en este curso.</p>
        <% } else { %>
            <% contenidos.forEach(contenido => { %>
                <li class="list-group-item">
                    <strong>Tipo:</strong> <%= contenido.tipo %> 
                    <% if (contenido.url_archivo) { %>
                        - <a href="<%= contenido.url_archivo %>" target="_blank">Ver archivo / enlace</a>
                    <% } %>
                    <% if (puedeGestionar) { %>
                        <form action="/cursos/<%= curso.id %>/contenidos/<%= contenido.id %>/editar" method="POST" class="mt-3">
                            <label class="form-label">Editar tipo</label>
                            <input name="tipo" class="form-control mb-2" value="<%= contenido.tipo %>" maxlength="50" required>
                            <label class="form-label">Editar URL</label>
                            <input name="url_archivo" type="url" class="form-control mb-2" value="<%= contenido.url_archivo || '' %>">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Guardar contenido</button>
                        </form>
                    <% } %>
                </li>
            <% }) %>
        <% } %>
    </ul>

    <% if (puedeGestionar) { %>
    <div class="mb-3">
        <a href="/cursos/<%= curso.id %>/contenidos/crear" class="btn btn-primary">Añadir nuevo contenido</a>
    </div>
    <% } %>

    <br>
    <a href="/cursos/<%= curso.id %>" class="btn btn-secondary">Volver al detalle del curso</a>

</body>
</html>