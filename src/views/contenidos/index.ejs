<!-- Archivo: src/views/contenidos/index.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Contenidos - <%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <!-- CABECERA MINIMALISTA -->
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <h1 class="text-verde-primario">Material de Estudio</h1>
                <p class="lead"><%= curso.titulo %></p>
            </div>
            
            <div id="btn-crear-contenido" class="d-none">
                <a href="/cursos/<%= curso.id %>/contenidos/crear" class="btn btn-primario shadow-sm">
                    <span class="fs-5 me-1">+</span> Subir Material
                </a>
            </div>
        </header>

        <main>
            <div class="mb-4">
                <a href="/cursos/<%= curso.id %>" class="btn btn-secundario">← Volver al curso</a>
            </div>

            <% if (contenidos && contenidos.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                    <% contenidos.forEach(contenido => { %>
                        <div class="tarjeta-contenido mb-0 p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            
                            <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                                <!-- Icono visual según tipo -->
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                                    <span class="fs-4">
                                        <%= contenido.tipo === 'pdf' ? '📄' : contenido.tipo === 'video' ? '🎬' : '🔗' %>
                                    </span>
                                </div>
                                <div>
                                    <span class="badge rounded-pill text-uppercase mb-1" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.7rem;">
                                        <%= contenido.tipo %>
                                    </span>
                                    <h5 class="fw-bold mb-0 text-dark">
                                        <a href="<%= contenido.url_archivo %>" target="_blank" class="text-decoration-none text-dark">
                                            Recurso de <%= contenido.tipo %>
                                        </a>
                                    </h5>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2">
                                <a href="<%= contenido.url_archivo %>" target="_blank" class="btn btn-secundario">
                                    Abrir / Descargar
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <!-- EMPTY STATE -->
                <div class="tarjeta-contenido text-center py-5">
                    <div class="fs-1 mb-3 opacity-50">📭</div>
                    <h4 class="text-verde-primario fw-bold">Sin contenidos</h4>
                    <p class="text-muted mb-0">Aún no se ha subido material de estudio a este curso.</p>
                </div>
            <% } %>
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const token = localStorage.getItem('token');
            if (token) {
                try {
                    const payload = JSON.parse(decodeURIComponent(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
                    if (payload.rol === 'profesor' || payload.rol === 'administrador') {
                        document.getElementById('btn-crear-contenido').classList.remove('d-none');
                    }
                } catch (e) { console.error(e); }
            }
        });
    </script>
</body>
</html>