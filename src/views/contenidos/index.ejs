<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contenidos del curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-beige">
    <div class="container">
        <header class="header-seccion">
            <h1>Contenidos del curso: <%= curso.titulo %></h1>
            <div class="barra-botones">
                <% if (puedeGestionar) { %>
                    <a href="/cursos/<%= curso.id %>/contenidos/crear" class="btn btn-primario">Añadir nuevo contenido</a>
                <% } %>
                <a href="/cursos/<%= curso.id %>" class="btn btn-secundario">Volver al detalle</a>
            </div>
        </header>

        <main class="tarjeta-contenido">
            <ul class="list-group">
                <% if (contenidos.length === 0) { %>
                    <p class="text-muted">Aún no hay contenidos registrados en este curso.</p>
                <% } else { %>
                    <% contenidos.forEach(contenido => { %>
                        <li class="list-group-item p-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <strong class="d-block mb-1">Tipo:</strong> <%= contenido.tipo %> 
                                    <% if (contenido.url_archivo) { %>
                                        <br><a href="<%= contenido.url_archivo %>" target="_blank" class="text-decoration-none">🔗 Ver archivo / enlace</a>
                                    <% } %>
                                </div>
                                
                                <% if (puedeGestionar) { %>
                                    <form action="/cursos/<%= curso.id %>/contenidos/<%= contenido.id %>/editar" method="POST" class="mt-2 mt-md-0">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <input name="tipo" class="form-control form-control-sm" value="<%= contenido.tipo %>" maxlength="50" required placeholder="Tipo">
                                            </div>
                                            <div class="col-md-6">
                                                <input name="url_archivo" type="url" class="form-control form-control-sm" value="<%= contenido.url_archivo || '' %>" placeholder="URL">
                                            </div>
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Guardar cambios</button>
                                            </div>
                                        </div>
                                    </form>
                                <% } %>
                            </div>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </main>
    </div>
</body>
</html>