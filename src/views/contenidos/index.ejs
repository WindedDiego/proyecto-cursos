<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Contenidos del curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Contenidos del curso: <%= curso.titulo %></h1>

    <ul class="list-group my-3">
        <% if (contenidos.length === 0) { %>
            <p class="text-muted">Aún no hay contenidos registrados en este curso.</p>
        <% } else { %>
            <% contenidos.forEach(contenido => { %>
                <li class="list-group-item">
                    <strong>Tipo:</strong> <%= contenido.tipo %> 
                    <% if (contenido.url_archivo) { %>
                        - <a href="<%= contenido.url_archivo %>" target="_blank">Ver archivo / enlace</a>
                    <% } %>
                </li>
            <% }) %>
        <% } %>
    </ul>

    <!-- Enlace de añadir contenido exclusivo para profesor -->
    <div id="seccion-crear-contenido" class="mb-3 d-none">
        <a href="/cursos/<%= curso.id %>/contenidos/crear" class="btn btn-primary">Añadir nuevo contenido</a>
    </div>

    <br>
    <a href="/cursos/<%= curso.id %>" class="btn btn-secondary">Volver al detalle del curso</a>

    <script>
        function obtenerRolDeToken() {
            const token = localStorage.getItem('token');
            if (!token) return null;
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload).rol;
            } catch (e) {
                return null;
            }
        }

        const rol = obtenerRolDeToken();
        if (rol === 'profesor') {
            document.getElementById('seccion-crear-contenido').classList.remove('d-none');
        }
    </script>
</body>
</html>