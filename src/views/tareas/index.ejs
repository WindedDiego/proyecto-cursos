<!-- ==========================================================================
     Archivo: src/views/tareas/index.ejs (Con botón de subida siempre visible)
     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tareas - <%= curso.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        
        <!-- CABECERA CON BOTÓN DE SUBIDA VISIBLE -->
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <span class="badge rounded-pill text-uppercase mb-2" style="background-color: var(--verde-claro); color: var(--verde-oscuro); font-size: 0.75rem;">Módulo de Trabajos</span>
                <h1 class="text-verde-primario">Entregas y Trabajos</h1>
                <p class="lead mb-0"><%= curso.titulo %></p>
            </div>
            
            <!-- Botón para subir la tarea directamente -->
            <div>
                <a href="/cursos/<%= curso.id %>/tareas/crear" class="btn btn-primario shadow-sm">
                    <span class="fs-5 me-1">📤</span> Subir Entrega
                </a>
            </div>
        </header>

        <main>
            <% if (tareas && tareas.length > 0) { %>
                <div class="d-flex flex-column">
                    <% tareas.forEach(tarea => { %>
                        <div class="tarjeta-lista flex-column flex-md-row">
                            <div class="icon-box">📝</div>
                            
                            <div class="flex-grow-1 text-center text-md-start">
                                <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 0.75rem;">
                                        Entrega Registrada
                                    </span>
                                </div>
                                <h4 class="fw-bold mb-1">Documento / Proyecto del alumno</h4>
                                <p class="text-muted small mb-0 text-truncate" style="max-width: 400px;">
                                    Enlace: <a href="<%= tarea.url_archivo %>" target="_blank" class="text-verde-primario"><%= tarea.url_archivo %></a>
                                </p>
                            </div>
                            
                            <div class="mt-3 mt-md-0 w-100 w-md-auto text-end">
                                <a href="<%= tarea.url_archivo %>" target="_blank" class="btn btn-secundario w-100">
                                    Visualizar Entrega &rarr;
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="icon">📥</div>
                    <h3 class="text-verde-primario fw-bold mb-2">Bandeja de entregas limpia</h3>
                    <p class="text-muted mb-4">No hay ninguna tarea o proyecto subido actualmente en este curso.</p>
                    <a href="/cursos/<%= curso.id %>/tareas/crear" class="btn btn-primario">
                        📤 Subir tu primera tarea ahora
                    </a>
                </div>
            <% } %>

            <a href="/cursos/<%= curso.id %>" class="btn-volver">
                <span class="fs-5">&larr;</span> Volver al resumen del curso
            </a>
        </main>
    </div>
</body>
</html>