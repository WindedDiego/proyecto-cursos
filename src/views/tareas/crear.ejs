<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Subir Tarea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>Subir Tarea para: <%= curso.titulo %></h1>
    
    <form action="/cursos/<%= curso.id %>/tareas" method="POST" class="mt-3">
        <div class="mb-3">
            <label class="form-label">URL del archivo o enlace de entrega</label>
            <input type="text" name="url_archivo" class="form-control" placeholder="https://..." required>
        </div>
        <button type="submit" class="btn btn-success">Guardar entrega</button>
        <a href="/cursos/<%= curso.id %>/tareas" class="btn btn-secondary">Cancelar</a>
    </form>
</body>
</html>