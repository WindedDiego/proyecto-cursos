     Archivo: src/views/tareas/enviar_entrega.ejs
     ========================================================================== -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Enviar Entrega - Plataforma Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <div class="container py-4">
        
        <!-- CABECERA -->
        <header class="header-seccion d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-4 mb-5">
            <div>
                <h1 class="text-verde-primario">Enviar Entrega</h1>
                <p class="text-muted fs-5 mt-2 mb-0">Sube tu archivo o proporciona un enlace para el ejercicio seleccionado.</p>
            </div>
            
            <div id="seccion-acciones-profesor" class="d-none d-flex flex-wrap gap-2 flex-shrink-0 mt-3 mt-md-0">
                <a href="/cursos/<%= curso.id %>/tareas" class="btn btn-secundario">
                    <span class="me-1">&larr;</span> Volver a Tareas
                </a>
            </div>
        </header>

        <!-- FORMULARIO -->
        <main>
            <div class="card shadow-sm p-4 border-0">
                <form action="/cursos/<%= curso.id %>/tareas/enviar_entrega/<%= id_ejercicio %>" method="POST" enctype="multipart/form-data">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Ejercicio:</label>
                        <p class="text-muted mb-1"><%= ejercicio ? ejercicio.titulo : 'Ejercicio no encontrado' %></p>
                        <% if (ejercicio && ejercicio.url_adjunto) { %>
                            <a href="<%= ejercicio.url_adjunto %>" target="_blank" rel="noopener" class="small">📎 Ver material del ejercicio</a>
                        <% } %>
                    </div>

                    <%- include('../partials/origen_archivo', { etiqueta: 'Opción de entrega:', obligatorio: true, maxMB: subida.limites.entregas }) %>

                    <div class="d-grid gap-2 d-md-block">
                        <button type="submit" class="btn btn-primario px-5 rounded-pill">
                            <span class="me-1">🚀</span> Enviar Entrega
                        </button>
                    </div>
                </form>
            </div>

            <!-- NAVEGACIÓN INFERIOR -->
            <div class="mt-4 pt-3 border-top" style="border-color: var(--borde-suave) !important;">
                <a href="/cursos/<%= curso.id %>/tareas" class="btn btn-volver">
                    <span class="fs-5">&larr;</span> Volver a Tareas
                </a>
            </div>
        </main>
    </div>

</body>
</html>